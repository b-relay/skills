#!/usr/bin/env python3
"""Wait for a time, or until a command succeeds, giving up at a deadline.

Usage:
  watch DEADLINE                      wait until DEADLINE, then exit 0
  watch DEADLINE [--every SECONDS] -- COMMAND [ARGS...]
                                      run COMMAND now and every SECONDS (default
                                      30) until it exits 0; exit 2 at DEADLINE

DEADLINE is a duration (90s, 30m, 2h, 1h30m), a local clock time (17:00 or
17:00:30, the next time that clock reads it), or an ISO 8601 date and time
(2026-10-28T17:00:00-04:00). Convert other time zones before passing one.

Prints one line when it exits, even on bad usage. Exit codes: 0 the time came
or the command succeeded, 2 the deadline passed first, 64 bad usage.
"""

import datetime as dt
import math
import os
import re
import signal
import subprocess
import sys
import tempfile
import time

STEP = 60  # longest single wait, so clock changes and far deadlines are handled


def usage(message):
    print(f"watch: {message}; see watch --help", file=sys.stderr)
    sys.exit(64)


def parse_deadline(text, now):
    duration = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
    if duration and any(duration.groups()):
        hours, minutes, seconds = (int(part or 0) for part in duration.groups())
        return now + dt.timedelta(hours=hours, minutes=minutes, seconds=seconds)
    clock = re.fullmatch(r"(\d{1,2}):(\d{2})(?::(\d{2}))?", text)
    if clock:
        hour, minute, second = (int(part or 0) for part in clock.groups())
        if hour > 23 or minute > 59 or second > 59:
            usage(f"not a clock time: {text}")
        local_now = now.replace(tzinfo=None)
        target = local_now.replace(hour=hour, minute=minute, second=second, microsecond=0)
        if target <= local_now:
            target += dt.timedelta(days=1)
        return target.astimezone()
    try:
        target = dt.datetime.fromisoformat(re.sub(r"[Zz]$", "+00:00", text))
    except ValueError:
        usage(f"not a duration, clock time or ISO date and time: {text}")
    if target.tzinfo is None:
        target = target.astimezone()
    return target


def seconds_left(deadline):
    return (deadline - dt.datetime.now().astimezone()).total_seconds()


def stop(process):
    """Kill everything the attempt started, then reap it."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass  # the group is already gone
    process.wait()


def main(argv):
    if not argv:
        usage("needs a deadline")
    if argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    sys.stdout.reconfigure(errors="replace")
    try:
        deadline = parse_deadline(argv[0], dt.datetime.now().astimezone())
    except (ValueError, OverflowError, OSError):
        usage(f"deadline out of range: {argv[0]}")
    rest = argv[1:]
    every = 30.0
    if rest[:1] == ["--every"]:
        if len(rest) < 2:
            usage("--every needs a number of seconds")
        try:
            every = float(rest[1])
        except ValueError:
            usage(f"not a number of seconds: {rest[1]}")
        if not math.isfinite(every) or every <= 0:
            usage("--every must be a positive number of seconds")
        rest = rest[2:]
    if rest and rest[0] != "--":
        usage(f"unexpected argument: {rest[0]}")
    command = rest[1:]
    if rest and not command:
        usage("-- needs a command after it")
    if argv[1:2] == ["--every"] and not command:
        usage("--every needs a command after --")

    started = time.monotonic()
    if not command:
        while (left := seconds_left(deadline)) > 0:
            time.sleep(min(left, STEP))
        print(f"time: {deadline.isoformat(timespec='seconds')} reached")
        return 0

    while True:
        # Output goes to a file and each attempt gets its own process group, so
        # success is the command's exit and cleanup reaches everything it started.
        attempt_started = time.monotonic()
        with tempfile.TemporaryFile() as out:
            try:
                process = subprocess.Popen(command, stdout=out, stderr=subprocess.DEVNULL,
                                           start_new_session=True)
            except OSError as error:
                usage(f"cannot run {command[0]}: {error.strerror}")
            try:
                while True:
                    try:
                        process.wait(timeout=min(max(seconds_left(deadline), 0.1), STEP))
                        break
                    except subprocess.TimeoutExpired:
                        if seconds_left(deadline) <= 0:
                            print(f"deadline: {deadline.isoformat(timespec='seconds')} passed "
                                  f"after {round(time.monotonic() - started)}s; command still running")
                            return 2
            finally:
                stop(process)
            elapsed = round(time.monotonic() - started)
            if process.returncode == 0:
                out.seek(0)
                output = out.read().decode(errors="replace").strip().splitlines()
                tail = f": {output[-1]}" if output else ""
                print(f"met after {elapsed}s{tail}")
                return 0
        if seconds_left(deadline) <= 0:
            print(f"deadline: {deadline.isoformat(timespec='seconds')} passed "
                  f"after {elapsed}s; last exit {process.returncode}")
            return 2
        next_try = attempt_started + every
        while (left := min(next_try - time.monotonic(), seconds_left(deadline))) > 0:
            time.sleep(min(left, STEP))


if __name__ == "__main__":
    # SIGTERM unwinds like Ctrl-C, so the attempt's cleanup still runs.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
